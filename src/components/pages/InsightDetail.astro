---
import PageHero from '../PageHero.astro';
import CtaBand from '../CtaBand.astro';
import Icon from '../Icon.astro';
import type { Insight } from '../../data/insights';
import { insights, formatDate } from '../../data/insights';
import { getLang, localize, t } from '../../i18n/ui';

interface Props { post: Insight }
const { post } = Astro.props;
const lang = getLang(Astro.url);
const related = insights.filter((i) => i.slug !== post.slug).slice(0, 3);
---

<PageHero
  eyebrow={post.category}
  title={post.title}
  crumbs={[
    { label: { en: 'Home', id: 'Beranda' }, href: '/' },
    { label: { en: 'Insights', id: 'Wawasan' }, href: '/insights' },
  ]}
  seed={post.slug.length * 4 + 9}
>
  <p class="mt-6 text-[0.8rem] text-slate-400">
    {formatDate(post.date, lang)} · {post.readingTime} {lang === 'id' ? 'menit baca' : 'min read'}
  </p>
</PageHero>

<article class="bg-white py-20 md:py-24">
  <div class="shell max-w-3xl">
    <p class="text-[1.05rem] font-semibold leading-relaxed text-ink-900" data-reveal>{t(post.excerpt, lang)}</p>
    <div class="mt-8 space-y-6" data-reveal data-reveal-delay="80">
      {post.body.map((para) => (
        <p class="text-[0.95rem] leading-[1.8] text-ink-600">{t(para, lang)}</p>
      ))}
    </div>
    <div class="mt-12 rounded-2xl border border-paper-200 bg-paper-100 p-8" data-reveal>
      <p class="text-[0.9rem] font-semibold text-ink-900">
        {lang === 'id'
          ? 'Menghadapi hal serupa di tim Anda?'
          : 'Facing something similar in your own team?'}
      </p>
      <a href={localize('/contact', lang)} class="link-arrow mt-3">
        {lang === 'id' ? 'Diskusikan dengan kami' : 'Talk it through with us'}
        <span class="arrow"><Icon name="arrow" size={14} /></span>
      </a>
    </div>
  </div>
</article>

<section class="bg-paper-100 py-20">
  <div class="shell">
    <div class="flex items-end justify-between gap-6">
      <h2 class="text-[1.5rem] font-bold text-ink-900">{lang === 'id' ? 'Bacaan lainnya' : 'Keep reading'}</h2>
      <a href={localize('/insights', lang)} class="link-arrow shrink-0">
        {lang === 'id' ? 'Semua wawasan' : 'All insights'} <span class="arrow"><Icon name="arrow" size={14} /></span>
      </a>
    </div>
    <div class="mt-8 grid gap-5 sm:grid-cols-3">
      {related.map((r, i) => (
        <a href={localize(`/insights/${r.slug}`, lang)} class="card p-6" data-reveal data-reveal-delay={i * 90}>
          <p class="text-[0.65rem] font-bold uppercase tracking-widest text-magenta-500">{t(r.category, lang)}</p>
          <h3 class="mt-3 text-[0.98rem] font-bold leading-snug text-ink-900">{t(r.title, lang)}</h3>
          <p class="mt-4 text-[0.72rem] text-ink-400">{formatDate(r.date, lang)}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<CtaBand />
