---
import { getLang, t, type L } from '../i18n/ui';

interface Props {
  eyebrow: L | string;
  title: L | string;
  accent?: L | string;
  lead?: L | string;
  /** Light copy for dark sections. */
  invert?: boolean;
  align?: 'left' | 'center';
  class?: string;
}

const lang = getLang(Astro.url);
const { eyebrow, title, accent, lead, invert = false, align = 'left', class: className = '' } = Astro.props;
const text = (v: L | string) => (typeof v === 'string' ? v : t(v, lang));
---

<div
  class:list={[
    'max-w-2xl',
    align === 'center' && 'mx-auto text-center',
    className,
  ]}
  data-reveal
>
  <p class:list={['eyebrow', invert && 'eyebrow-light']}>{text(eyebrow)}</p>
  <h2
    class:list={[
      'mt-3 text-[clamp(1.85rem,3.4vw,2.75rem)]',
      invert ? 'text-white' : 'text-ink-900',
    ]}
  >
    {text(title)}
    {accent && <><br /><span class="text-accent">{text(accent)}</span></>}
  </h2>
  {lead && (
    <p class:list={['mt-5 text-[0.95rem] leading-relaxed', invert ? 'text-slate-300' : 'text-ink-600']}>
      {text(lead)}
    </p>
  )}
</div>
