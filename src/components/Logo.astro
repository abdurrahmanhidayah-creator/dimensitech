---
interface Props {
  class?: string;
  /** Dark text for use on light backgrounds. */
  dark?: boolean;
}
const { class: className = '', dark = false } = Astro.props;
---

<span class={`inline-flex items-center ${className}`}>
  <img
    src="/assets/logo-dimensi.png"
    alt="Dimensi"
    class:list={[
      'h-9 w-auto object-contain',
      dark ? 'brightness-0' : '',
    ]}
  />
</span>
