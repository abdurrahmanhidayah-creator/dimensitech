---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WorkDetail from '../../../components/pages/WorkDetail.astro';
import { caseStudies } from '../../../data/work';
import { t } from '../../../i18n/ui';

export function getStaticPaths() {
  return caseStudies.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const lang = 'id' as const;
---
<BaseLayout
  title={`${t(item.title, lang)} — Dimensi`}
  description={t(item.summary, lang)}
  path={`/work/${item.slug}`}
>
  <WorkDetail study={item} />
</BaseLayout>
