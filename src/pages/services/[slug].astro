---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceDetail from '../../components/pages/ServiceDetail.astro';
import { services } from '../../data/services';
import { t } from '../../i18n/ui';

export function getStaticPaths() {
  return services.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const lang = 'en' as const;
---
<BaseLayout
  title={`${t(item.title, lang)} — Dimensi`}
  description={t(item.short, lang)}
  path={`/services/${item.slug}`}
>
  <ServiceDetail service={item} />
</BaseLayout>
