---
import PageHero from '../PageHero.astro';
import Icon from '../Icon.astro';
import { pages } from '../../data/pages';
import { site } from '../../data/site';
import { services } from '../../data/services';
import { getLang, t } from '../../i18n/ui';

const lang = getLang(Astro.url);
const p = pages.contact;

const copy = {
  name: { en: 'Full name', id: 'Nama lengkap' },
  email: { en: 'Work email', id: 'Email kantor' },
  company: { en: 'Company', id: 'Perusahaan' },
  interest: { en: 'What can we help with?', id: 'Apa yang bisa kami bantu?' },
  choose: { en: 'Select a service', id: 'Pilih layanan' },
  other: { en: 'Something else', id: 'Lainnya' },
  message: { en: 'Tell us about your project', id: 'Ceritakan tentang proyek Anda' },
  send: { en: 'Send enquiry', id: 'Kirim pesan' },
  note: {
    en: 'This form opens your email client with the details filled in. Prefer to write directly? Use the address below.',
    id: 'Formulir ini membuka aplikasi email Anda dengan isian yang sudah terisi. Ingin menulis langsung? Gunakan alamat di bawah.',
  },
  reach: { en: 'Reach us directly', id: 'Hubungi kami langsung' },
  hours: { en: 'Office hours', id: 'Jam kerja' },
  hoursValue: {
    en: 'Monday – Friday, 09:00 – 18:00 WIB',
    id: 'Senin – Jumat, 09.00 – 18.00 WIB',
  },
};
---

<PageHero
  eyebrow={p.eyebrow}
  title={p.title}
  accent={p.accent}
  lead={p.lead}
  crumbs={[{ label: { en: 'Home', id: 'Beranda' }, href: '/' }, { label: p.eyebrow, href: '/contact' }]}
  seed={83}
/>

<section class="bg-white py-20 md:py-24">
  <div class="shell grid gap-14 lg:grid-cols-[1.25fr_1fr]">
    <form id="contact-form" class="rounded-2xl border border-paper-200 bg-paper-100 p-8 md:p-10" data-reveal novalidate>
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block">
          <span class="text-[0.75rem] font-bold uppercase tracking-wider text-ink-600">{t(copy.name, lang)}</span>
          <input
            name="name"
            required
            autocomplete="name"
            class="mt-2 h-12 w-full rounded-lg border border-paper-200 bg-white px-4 text-[0.9rem] text-ink-900 outline-none transition-colors focus:border-magenta-500"
          />
        </label>
        <label class="block">
          <span class="text-[0.75rem] font-bold uppercase tracking-wider text-ink-600">{t(copy.email, lang)}</span>
          <input
            name="email"
            type="email"
            required
            autocomplete="email"
            class="mt-2 h-12 w-full rounded-lg border border-paper-200 bg-white px-4 text-[0.9rem] text-ink-900 outline-none transition-colors focus:border-magenta-500"
          />
        </label>
        <label class="block sm:col-span-2">
          <span class="text-[0.75rem] font-bold uppercase tracking-wider text-ink-600">{t(copy.company, lang)}</span>
          <input
            name="company"
            autocomplete="organization"
            class="mt-2 h-12 w-full rounded-lg border border-paper-200 bg-white px-4 text-[0.9rem] text-ink-900 outline-none transition-colors focus:border-magenta-500"
          />
        </label>
        <label class="block sm:col-span-2">
          <span class="text-[0.75rem] font-bold uppercase tracking-wider text-ink-600">{t(copy.interest, lang)}</span>
          <select
            name="interest"
            class="mt-2 h-12 w-full rounded-lg border border-paper-200 bg-white px-4 text-[0.9rem] text-ink-900 outline-none transition-colors focus:border-magenta-500"
          >
            <option value="">{t(copy.choose, lang)}</option>
            {services.map((s) => <option value={t(s.title, 'en')}>{t(s.title, lang)}</option>)}
            <option value="Other">{t(copy.other, lang)}</option>
          </select>
        </label>
        <label class="block sm:col-span-2">
          <span class="text-[0.75rem] font-bold uppercase tracking-wider text-ink-600">{t(copy.message, lang)}</span>
          <textarea
            name="message"
            rows="5"
            required
            class="mt-2 w-full rounded-lg border border-paper-200 bg-white p-4 text-[0.9rem] leading-relaxed text-ink-900 outline-none transition-colors focus:border-magenta-500"
          ></textarea>
        </label>
      </div>

      <button type="submit" class="btn mt-7 w-full sm:w-auto">
        {t(copy.send, lang)} <span class="arrow"><Icon name="arrow" size={15} /></span>
      </button>
      <p class="mt-4 text-[0.75rem] leading-relaxed text-ink-400">{t(copy.note, lang)}</p>
    </form>

    <div class="space-y-8" data-reveal data-reveal-delay="120">
      <div>
        <h2 class="text-[1.2rem] font-bold text-ink-900">{t(copy.reach, lang)}</h2>
        <ul class="mt-6 space-y-5">
          <li class="flex gap-4">
            <span class="icon-badge h-11 w-11 shrink-0 bg-magenta-500/10 text-magenta-500"><Icon name="mail" size={19} /></span>
            <span>
              <span class="block text-[0.7rem] font-bold uppercase tracking-wider text-ink-400">Email</span>
              <a href={`mailto:${site.email}`} class="text-[0.92rem] font-semibold text-ink-900 hover:text-magenta-500">{site.email}</a>
            </span>
          </li>
          <li class="flex gap-4">
            <span class="icon-badge h-11 w-11 shrink-0 bg-magenta-500/10 text-magenta-500"><Icon name="phone" size={19} /></span>
            <span>
              <span class="block text-[0.7rem] font-bold uppercase tracking-wider text-ink-400">{lang === 'id' ? 'Telepon' : 'Phone'}</span>
              <a href={`tel:${site.phoneHref}`} class="text-[0.92rem] font-semibold text-ink-900 hover:text-magenta-500">{site.phone}</a>
            </span>
          </li>
          <li class="flex gap-4">
            <span class="icon-badge h-11 w-11 shrink-0 bg-magenta-500/10 text-magenta-500"><Icon name="pin" size={19} /></span>
            <span>
              <span class="block text-[0.7rem] font-bold uppercase tracking-wider text-ink-400">{lang === 'id' ? 'Kantor' : 'Office'}</span>
              <span class="text-[0.92rem] font-semibold leading-relaxed text-ink-900">{t(site.address, lang)}</span>
            </span>
          </li>
          <li class="flex gap-4">
            <span class="icon-badge h-11 w-11 shrink-0 bg-magenta-500/10 text-magenta-500"><Icon name="clock" size={19} /></span>
            <span>
              <span class="block text-[0.7rem] font-bold uppercase tracking-wider text-ink-400">{t(copy.hours, lang)}</span>
              <span class="text-[0.92rem] font-semibold text-ink-900">{t(copy.hoursValue, lang)}</span>
            </span>
          </li>
        </ul>
      </div>

      <img
        src="/assets/office.png"
        alt={lang === 'id' ? 'Kantor Dimensi di Jakarta' : 'The Dimensi office in Jakarta'}
        class="w-full rounded-2xl border border-paper-200 object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>

<script is:inline define:vars={{ mailTo: site.email }}>
  // No backend on a static host: compose a prefilled email instead.
  // To use a real endpoint, give the form an `action` and remove this handler.
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const get = (key) => String(data.get(key) ?? '').trim();

    const subject = `Website enquiry — ${get('company') || get('name')}`;
    const body = [
      `Name: ${get('name')}`,
      `Email: ${get('email')}`,
      `Company: ${get('company') || '—'}`,
      `Interest: ${get('interest') || '—'}`,
      '',
      get('message'),
    ].join('\n');

    window.location.href = `mailto:${mailTo}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
